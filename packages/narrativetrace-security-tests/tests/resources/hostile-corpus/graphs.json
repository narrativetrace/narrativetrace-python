{
  "$comment": "Object-graph shapes, declared rather than serialised: a builder in each runtime turns a case into a live object graph. `layers` stacks wrappers outward around `payload` (index 0 is innermost); `kind` names a shape that cannot be expressed as a stack. See README.md.",
  "cases": [
    { "id": "scalar", "description": "the degenerate graph", "payload": "secret-record", "layers": [] },
    { "id": "optional", "description": "the container that leaked", "payload": "secret-record", "layers": ["optional"] },
    { "id": "optional-in-optional", "description": "two wrappers of the same kind", "payload": "secret-record", "layers": ["optional", "optional"] },
    { "id": "atomic-reference", "description": "the other single-payload holder that leaked", "payload": "secret-record", "layers": ["atomicReference"] },
    { "id": "atomic-reference-array", "description": "the indexed holder that leaked through Arrays.toString", "payload": "secret-record", "layers": ["atomicReferenceArray"] },
    { "id": "map-entry", "description": "a standalone Map.Entry, which printed key=value over raw payloads", "payload": "secret-record", "layers": ["entryValue"] },
    { "id": "map-entry-key", "description": "the same holder, with the payload as the key", "payload": "secret-record", "layers": ["entryKey"] },
    { "id": "future", "description": "a completed future holding the payload", "payload": "secret-record", "layers": ["future"] },
    { "id": "optional-in-map-in-record", "description": "the chain the parity doc names by hand", "payload": "secret-record", "layers": ["optional", "map", "record"] },
    { "id": "record-in-list-in-optional-in-map", "description": "four wrapper kinds, alternating", "payload": "secret-record", "layers": ["record", "list", "optional", "map"] },
    { "id": "every-layer-once", "description": "one of each wrapper the renderer knows", "payload": "secret-record", "layers": ["optional", "atomicReference", "list", "array", "map", "entryValue", "future", "record", "atomicReferenceArray"] },
    { "id": "depth-8-optional", "description": "eight Optionals deep", "payload": "secret-record", "kind": "repeatLayer", "layer": "optional", "n": 8 },
    { "id": "depth-64-list", "description": "sixty-four singleton lists deep", "payload": "secret-record", "kind": "repeatLayer", "layer": "list", "n": 64 },
    { "id": "depth-1000-chain", "description": "a thousand-node holder chain - the stack-depth case", "payload": "secret-record", "kind": "repeatLayer", "layer": "holder", "n": 1000 },
    { "id": "depth-10000-chain", "description": "ten thousand nodes: deeper than a default JVM stack tolerates recursively", "payload": "secret-record", "kind": "repeatLayer", "layer": "holder", "n": 10000 },
    { "id": "depth-1000-array", "description": "a thousand nested single-element arrays", "payload": "secret-record", "kind": "repeatLayer", "layer": "array", "n": 1000 },
    { "id": "width-10000-list", "description": "ten thousand siblings, the payload last", "payload": "secret-record", "kind": "width", "container": "list", "n": 10000 },
    { "id": "width-10000-map", "description": "ten thousand map entries, the payload last", "payload": "secret-record", "kind": "width", "container": "map", "n": 10000 },
    { "id": "width-10000-array", "description": "ten thousand array elements, the payload last", "payload": "secret-record", "kind": "width", "container": "array", "n": 10000 },
    { "id": "width-100000-list", "description": "a hundred thousand siblings - the bounded-output case", "payload": "secret-record", "kind": "width", "container": "list", "n": 100000 },
    { "id": "cycle-two-nodes", "description": "a holds b, b holds a", "kind": "cycle", "n": 2, "payload": "secret-record" },
    { "id": "cycle-long", "description": "a hundred-node ring", "kind": "cycle", "n": 100, "payload": "secret-record" },
    { "id": "self-reference", "description": "a holder that holds itself", "kind": "cycle", "n": 1, "payload": "secret-record" },
    { "id": "self-in-collection", "description": "a list that contains itself", "kind": "selfInCollection", "container": "list", "payload": "secret-record" },
    { "id": "self-in-map-value", "description": "a map whose value is the map", "kind": "selfInCollection", "container": "map", "payload": "secret-record" },
    { "id": "self-in-map-key", "description": "a map whose key is the map - hashCode recurses too", "kind": "selfInCollection", "container": "mapKey", "payload": "secret-record" },
    { "id": "self-in-array", "description": "an array holding itself", "kind": "selfInCollection", "container": "array", "payload": "secret-record" },
    { "id": "self-in-atomic-reference-array", "description": "the indexed holder holding itself", "kind": "selfInCollection", "container": "atomicReferenceArray", "payload": "secret-record" },
    { "id": "self-in-entry", "description": "an entry whose value is the entry", "kind": "selfInCollection", "container": "entry", "payload": "secret-record" },
    { "id": "diamond", "description": "the same object reached twice by different paths - shared, not cyclic", "kind": "diamond", "payload": "secret-record" },
    { "id": "throwing-to-string", "description": "a toString that throws", "kind": "hostileMember", "member": "toStringThrows", "payload": "secret-record" },
    { "id": "throwing-to-string-with-secret", "description": "a toString whose exception message carries the payload", "kind": "hostileMember", "member": "toStringThrowsWithPayload", "payload": "secret-record" },
    { "id": "recursive-to-string", "description": "a toString that recurses until the stack ends", "kind": "hostileMember", "member": "toStringRecurses", "payload": "secret-record" },
    { "id": "slow-to-string", "description": "a toString that blocks, bounded so the budget assertion is the failure", "kind": "hostileMember", "member": "toStringBlocks", "payload": "secret-record" },
    { "id": "huge-to-string", "description": "a toString returning a megabyte", "kind": "hostileMember", "member": "toStringHuge", "payload": "secret-record" },
    { "id": "null-to-string", "description": "a toString returning null", "kind": "hostileMember", "member": "toStringNull", "payload": "secret-record" },
    { "id": "number-hostile-to-string", "description": "a Number subclass whose toString is a forged narrative line: newline, fence, JSON structure, NaN/Infinity text - the scalar fast path that used to skip sanitizing", "kind": "hostileMember", "member": "numberHostileToString", "payload": "secret-record" },
    { "id": "throwing-hash-code", "description": "a hashCode that throws - breaks any identity set that hashes", "kind": "hostileMember", "member": "hashCodeThrows", "payload": "secret-record" },
    { "id": "throwing-equals", "description": "an equals that throws", "kind": "hostileMember", "member": "equalsThrows", "payload": "secret-record" },
    { "id": "throwing-getter", "description": "a bean getter that throws while being introspected", "kind": "hostileMember", "member": "getterThrows", "payload": "secret-record" },
    { "id": "throwing-accessor-record", "description": "a record component accessor that throws", "kind": "hostileMember", "member": "accessorThrows", "payload": "secret-record" },
    { "id": "hostile-key-names", "description": "map keys carrying invisible and homoglyph characters, so the deny-list matches none of them", "kind": "hostileMember", "member": "hostileKeyNames", "payload": "secret-record" },
    { "id": "many-fields", "description": "an object with twelve fields, past the five-field cap, the payload beyond it", "kind": "manyFields", "n": 12, "payload": "secret-record" },
    { "id": "nulls-throughout", "description": "a list of nulls with the payload at the end", "kind": "width", "container": "listWithNulls", "n": 100, "payload": "secret-record" },
    { "id": "empty-containers", "description": "every empty container, nested", "kind": "emptyContainers" },
    { "id": "future-pending", "description": "a future that never completes", "kind": "future", "state": "pending" },
    { "id": "future-failed", "description": "a future completed exceptionally, the payload in the cause message", "kind": "future", "state": "failed", "payload": "secret-record" },
    { "id": "future-cancelled", "description": "a cancelled future", "kind": "future", "state": "cancelled" },
    { "id": "exception-with-message", "description": "an exception carrying prose - what a message may legitimately show, so the oracle here is well-formedness, not containment", "kind": "throwable", "payload": "plain-text" },
    { "id": "exception-cause-chain", "description": "a fifty-deep cause chain", "kind": "throwable", "n": 50, "payload": "plain-text" },
    { "id": "suppressed-exception", "description": "a suppressed exception, which no cause-chain walk reaches", "kind": "throwable", "state": "suppressed", "payload": "plain-text" }
  ]
}
